{
  "name": "psat-secure-exam",
  "version": "1.0.0",
  "description": "PSAT Secure Exam System - SMA Khairul Ulum",
  "scripts": {
    "build:css": "postcss src/styles/main.css -o dist/styles.css",
    "build:css:watch": "postcss src/styles/main.css -o dist/styles.css --watch",
    "build": "npm run build:css && echo 'Build complete!'",
    "dev": "npm run build:css:watch"
  },
  "devDependencies": {
    "postcss": "^8.4.38",
    "postcss-cli": "^11.0.0",
    "autoprefixer": "^10.4.19",
    "tailwindcss": "^3.4.17",
    "cssnano": "^7.0.2",
    "postcss-import": "^16.1.0",
    "postcss-nested": "^6.2.0",
    "postcss-custom-properties": "^13.3.12",
    "postcss-preset-env": "^9.5.14"
  }
}
